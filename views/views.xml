<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- =========================================================
       SEARCH VIEWS
       ========================================================= -->

  <record id="view_partner_search_afiliado" model="ir.ui.view">
    <field name="name">res.partner.search.afiliado</field>
    <field name="model">res.partner</field>
    <field name="arch" type="xml">
      <search string="Buscar afiliación">
        <field name="name"/>
        <field name="dni"/>
        <field name="numero_afiliado"/>
        <field name="email"/>
        <field name="mobile"/>
        <field name="sede"/>
        <field name="especialidade_id"/>
        <field name="centro_traballo_id"/>
        <field name="situacion_laboral"/>

        <filter string="Só activos" name="f_activos" domain="[('afiliacion_activa','=',True)]"/>
        <filter string="Só inactivos" name="f_inactivos" domain="[('afiliacion_activa','=',False)]"/>

        <group expand="0" string="Agrupar por">
          <filter string="Sede" name="g_sede" context="{'group_by':'sede'}"/>
          <filter string="Situación laboral" name="g_sit" context="{'group_by':'situacion_laboral'}"/>
          <filter string="Centro de traballo" name="g_centro" context="{'group_by':'centro_traballo_id'}"/>
          <filter string="Especialidade" name="g_esp" context="{'group_by':'especialidade_id'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="view_partner_search_centro" model="ir.ui.view">
    <field name="name">res.partner.search.centro</field>
    <field name="model">res.partner</field>
    <field name="arch" type="xml">
      <search string="Buscar centros">
        <field name="name"/>
        <field name="codigo_centro"/>
        <field name="email"/>
        <field name="phone"/>
        <field name="city"/>
        <field name="state_id"/>

        <group expand="0" string="Agrupar por">
          <filter string="Provincia" name="g_prov" context="{'group_by':'state_id'}"/>
          <filter string="Cidade" name="g_city" context="{'group_by':'city'}"/>
        </group>
      </search>
    </field>
  </record>

  <!-- =========================================================
       ACCIÓNS / MENÚS
       ========================================================= -->

  <record id="action_sindicato_afiliados" model="ir.actions.act_window">
    <field name="name">Afiliación</field>
    <field name="res_model">res.partner</field>
    <field name="view_mode">kanban,list,form</field>
    <field name="domain">[('e_afiliado','=',True)]</field>
    <field name="context">{'default_e_afiliado': True, 'default_company_type': 'person'}</field>
    <field name="search_view_id" ref="view_partner_search_afiliado"/>
  </record>

  <record id="action_sindicato_centros" model="ir.actions.act_window">
    <field name="name">Centros educativos</field>
    <field name="res_model">res.partner</field>
    <field name="view_mode">kanban,list,form</field>
    <field name="domain">[('e_centro_educativo','=',True)]</field>
    <field name="context">{'default_e_centro_educativo': True, 'default_company_type': 'company'}</field>
    <field name="search_view_id" ref="view_partner_search_centro"/>
  </record>

  <!-- Oculta afiliados e centros do menú estándar de contactos -->
  <record id="contacts.action_contacts" model="ir.actions.act_window">
    <field name="domain">[('e_afiliado', '=', False), ('e_centro_educativo', '=', False)]</field>
  </record>

  <menuitem id="menu_sindicato_root"
            name="Afiliación e Centros"
            sequence="1"
            web_icon="steg_afiliacion,static/description/icon.png"/>

  <menuitem id="menu_sindicato_afiliados"
            name="Afiliación"
            parent="menu_sindicato_root"
            action="action_sindicato_afiliados"
            sequence="10"/>

  <menuitem id="menu_sindicato_centros"
            name="Centros educativos"
            parent="menu_sindicato_root"
            action="action_sindicato_centros"
            sequence="20"/>

  <menuitem id="menu_sindicato_config"
            name="Configuración"
            parent="menu_sindicato_root"
            sequence="90"/>

  <!-- =========================================================
       LISTAS
       ========================================================= -->

  <record id="view_partner_list_afiliado" model="ir.ui.view">
    <field name="name">res.partner.list.afiliado</field>
    <field name="model">res.partner</field>
    <field name="priority">20</field>
    <field name="arch" type="xml">
      <list string="Afiliados" create="1" edit="1">
        <field name="numero_afiliado"/>
        <field name="name"/>
        <field name="sede"/>
        <field name="phone"/>
        <field name="mobile"/>
        <field name="email"/>
        <field name="centro_traballo_id"/>
        <field name="especialidade_id"/>
        <field name="situacion_laboral"/>
      </list>
    </field>
  </record>

  <record id="view_partner_list_centro" model="ir.ui.view">
    <field name="name">res.partner.list.centro</field>
    <field name="model">res.partner</field>
    <field name="priority">20</field>
    <field name="arch" type="xml">
      <list string="Centros educativos" create="1" edit="1">
        <field name="codigo_centro"/>
        <field name="name"/>
        <field name="phone"/>
        <field name="email"/>
        <field name="city"/>
        <field name="state_id"/>
      </list>
    </field>
  </record>

  <!-- =========================================================
       KANBAN
       ========================================================= -->

  <record id="view_partner_kanban_afiliado" model="ir.ui.view">
    <field name="name">res.partner.kanban.afiliado</field>
    <field name="model">res.partner</field>
    <field name="priority">25</field>
    <field name="arch" type="xml">
      <kanban class="o_kanban_small_column">
        <field name="name"/>
        <field name="centro_traballo_id"/>
        <field name="especialidade_id"/>
        <field name="situacion_laboral"/>

        <templates>
          <t t-name="kanban-box">
            <div class="o_kanban_record">
              <div class="o_kanban_record_title">
                <strong><field name="name"/></strong>
              </div>

              <div class="mt-2" t-if="record.centro_traballo_id.value">
                <span class="text-muted">Centro:</span>
                <field name="centro_traballo_id"/>
              </div>

              <div t-if="record.especialidade_id.value">
                <span class="text-muted">Especialidade:</span>
                <field name="especialidade_id"/>
              </div>

              <div t-if="record.situacion_laboral.value">
                <span class="text-muted">Situación:</span>
                <field name="situacion_laboral"/>
              </div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <record id="view_partner_kanban_centro" model="ir.ui.view">
    <field name="name">res.partner.kanban.centro</field>
    <field name="model">res.partner</field>
    <field name="priority">25</field>
    <field name="arch" type="xml">
      <kanban class="o_kanban_small_column">
        <field name="name"/>
        <field name="city"/>
        <field name="state_id"/>

        <templates>
          <t t-name="kanban-box">
            <div class="o_kanban_record">
              <div class="o_kanban_record_title">
                <strong><field name="name"/></strong>
              </div>

              <div class="mt-2" t-if="record.city.value">
                <span class="text-muted">Localidade:</span>
                <field name="city"/>
              </div>

              <div t-if="record.state_id.value">
                <span class="text-muted">Provincia:</span>
                <field name="state_id"/>
              </div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <!-- =========================================================
       FORMULARIO UNIFICADO: HERDAMOS O PARTNER ESTÁNDAR
       ========================================================= -->

  <record id="view_partner_form_sindicato_inherit" model="ir.ui.view">
  <field name="name">res.partner.form.sindicato.inherit</field>
  <field name="model">res.partner</field>
  <field name="priority">90</field>
  <field name="inherit_id" ref="base.view_partner_form"/>
  <field name="arch" type="xml">

    <!-- Campos usados en expresións -->
    <xpath expr="//sheet" position="inside">
      <group invisible="1">
        <field name="e_afiliado"/>
        <field name="e_centro_educativo"/>
        <field name="afiliacion_activa"/>
        <field name="ligazon_google_maps"/>
        <field name="ligazon_osm"/>
      </group>
    </xpath>

    <xpath expr="//span[@name='address_name']" position="before">
  <field name="codigo_centro" invisible="not e_centro_educativo"/>
</xpath>

    <!-- Páxinas específicas -->
<xpath expr="//page[@name='contact_addresses']" position="before">
      <page string="Afiliación" invisible="not e_afiliado">
        <group>
          <group string="Identificación">
            <field name="dni"/>
            <field name="numero_afiliado"/>
            <field name="xenero"/>
            <field name="birthdate_date"/>
            <field name="age" readonly="1"/>
          </group>

          <group string="Datos de afiliación">
            <field name="afiliacion_activa" readonly="1"/>
            <field name="data_alta"/>
            <field name="data_baixa"/>
            <field name="anos_afiliacion" readonly="1"/>
            <field name="sede"/>
          </group>
        </group>
      </page>

      <page string="Profesional" invisible="not e_afiliado">
        <group>
          <separator string="Situación Actual"/>
          <field name="especialidade_id"/>
          <field name="centro_traballo_id" domain="[('e_centro_educativo','=',True)]"/>
          <field name="situacion_laboral"/>

          <separator string="Historial profesional"/>
          <field name="historial_profesional_ids" nolabel="1">
            <list editable="bottom">
              <field name="data_cambio"/>
              <field name="centro_id"/>
              <field name="especialidade_id"/>
              <field name="situacion_laboral"/>
              <field name="observacions"/>
            </list>
          </field>
        </group>
      </page>

      <page string="Afiliados" invisible="not e_centro_educativo">
        <field name="afiliados_actuales_ids" nolabel="1" readonly="1">
          <list string="Afiliados do centro" create="0" edit="0" delete="0">
            <field name="name"/>
            <field name="mobile"/>
            <field name="email"/>
            <field name="situacion_laboral"/>
            <field name="especialidade_id"/>
          </list>
        </field>
      </page>

      <page string="Xeolocalización" invisible="not e_centro_educativo">
        <group string="Coordenadas" groups="base.group_system">
          <field name="partner_latitude"/>
          <field name="partner_longitude"/>
        </group>

        <group string="Ligazóns">
          <field name="ligazon_google_maps" widget="url" readonly="1" invisible="not ligazon_google_maps"/>
          <field name="ligazon_osm" widget="url" readonly="1" invisible="not ligazon_osm"/>

          <div class="o_form_label" invisible="ligazon_google_maps or ligazon_osm">
            (Non hai coordenadas GPS gardadas)
          </div>
        </group>
      </page>

    </xpath>

    <!-- Engadir tipo de cota na páxina de contabilidade / contas -->
    <xpath expr="//group[@name='banks']" position="after">
      <group invisible="not e_afiliado" string="Afiliación">
        <field name="tipo_cota_id"/>
      </group>
    </xpath>

  </field>
</record>

<record id="view_partner_form_sindicato_cleanup" model="ir.ui.view">
  <field name="name">res.partner.form.sindicato.cleanup</field>
  <field name="model">res.partner</field>
  <field name="priority">95</field>
  <field name="inherit_id" ref="base.view_partner_form"/>
  <field name="arch" type="xml">

    <!-- Campos técnicos para expresións -->
    <xpath expr="//sheet" position="inside">
      <group invisible="1">
        <field name="e_afiliado"/>
        <field name="e_centro_educativo"/>
      </group>
    </xpath>

    <!-- Ocultar pestaña Contacts & Addresses para afiliados y centros -->
    <xpath expr="//page[@name='contact_addresses']" position="attributes">
      <attribute name="invisible">e_afiliado or e_centro_educativo</attribute>
    </xpath>

    <!-- Ocultar pestaña Sales & Purchase para afiliados y centros -->
    <xpath expr="//page[@name='sales_purchases']" position="attributes">
      <attribute name="invisible">e_afiliado or e_centro_educativo</attribute>
    </xpath>

    <!-- Ocultar pestaña Facturación para centros -->
    <xpath expr="//page[.//field[@name='bank_ids']]" position="attributes">
      <attribute name="invisible">e_centro_educativo</attribute>
    </xpath>

    <!-- Ocultar algunos campos estándar para afiliados -->
    <xpath expr="//field[@name='function']" position="attributes">
      <attribute name="invisible">e_afiliado or e_centro_educativo</attribute>
    </xpath>

    <xpath expr="//field[@name='parent_id']" position="attributes">
      <attribute name="invisible">e_afiliado or is_company</attribute>
    </xpath>

    <xpath expr="//field[@name='website']" position="attributes">
      <attribute name="invisible">e_afiliado</attribute>
    </xpath>

    <xpath expr="//field[@name='title']" position="attributes">
      <attribute name="invisible">e_afiliado or e_centro_educativo</attribute>
    </xpath>

    <xpath expr="//field[@name='vat']" position="attributes">
      <attribute name="invisible">e_afiliado or e_centro_educativo</attribute>
    </xpath>

    <!-- OCULTAR GRUPOS DE FACTURACIÓN (ACCOUNTING) -->

    <!-- Customer Invoices -->
    <xpath expr="//group[@id='invoice_send_settings']" position="attributes">
      <attribute name="invisible">e_afiliado or e_centro_educativo</attribute>
    </xpath>

    <!-- Accounting Entries -->
    <xpath expr="//group[@name='accounting_entries']" position="attributes">
      <attribute name="invisible">e_afiliado or e_centro_educativo</attribute>
    </xpath>

    <!-- Credit Limits -->
    <xpath expr="//group[@name='credit_limits']" position="attributes">
      <attribute name="invisible">e_afiliado or e_centro_educativo</attribute>
    </xpath>

    <!-- Automation -->
    <xpath expr="//group[@name='accounting_automation']" position="attributes">
      <attribute name="invisible">e_afiliado or e_centro_educativo</attribute>
    </xpath>

  </field>
</record>

  <!-- =========================================================
       VINCULAR VISTAS ÁS ACCIÓNS
       ========================================================= -->

  <record id="action_sindicato_afiliados_view_kanban" model="ir.actions.act_window.view">
    <field name="sequence" eval="1"/>
    <field name="view_mode">kanban</field>
    <field name="view_id" ref="view_partner_kanban_afiliado"/>
    <field name="act_window_id" ref="action_sindicato_afiliados"/>
  </record>

  <record id="action_sindicato_afiliados_view_list" model="ir.actions.act_window.view">
    <field name="sequence" eval="2"/>
    <field name="view_mode">list</field>
    <field name="view_id" ref="view_partner_list_afiliado"/>
    <field name="act_window_id" ref="action_sindicato_afiliados"/>
  </record>

  <!-- Non fixamos unha vista form específica: usamos a herdada de res.partner -->

  <record id="action_sindicato_centros_view_kanban" model="ir.actions.act_window.view">
    <field name="sequence" eval="1"/>
    <field name="view_mode">kanban</field>
    <field name="view_id" ref="view_partner_kanban_centro"/>
    <field name="act_window_id" ref="action_sindicato_centros"/>
  </record>

  <record id="action_sindicato_centros_view_list" model="ir.actions.act_window.view">
    <field name="sequence" eval="2"/>
    <field name="view_mode">list</field>
    <field name="view_id" ref="view_partner_list_centro"/>
    <field name="act_window_id" ref="action_sindicato_centros"/>
  </record>

  <!-- =========================================================
       CATÁLOGOS: ESPECIALIDADES E TIPOS DE COTA
       ========================================================= -->

  <record id="view_especialidade_list" model="ir.ui.view">
    <field name="name">sindicato.especialidade.list</field>
    <field name="model">sindicato.especialidade</field>
    <field name="arch" type="xml">
      <list string="Especialidades">
        <field name="corpo"/>
        <field name="codigo_oficial"/>
        <field name="nome"/>
        <field name="activo"/>
      </list>
    </field>
  </record>

  <record id="view_especialidade_form" model="ir.ui.view">
    <field name="name">sindicato.especialidade.form</field>
    <field name="model">sindicato.especialidade</field>
    <field name="arch" type="xml">
      <form string="Especialidade">
        <sheet>
          <group>
            <field name="corpo"/>
            <field name="codigo_oficial"/>
            <field name="nome"/>
            <field name="activo"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_especialidades" model="ir.actions.act_window">
    <field name="name">Especialidades</field>
    <field name="res_model">sindicato.especialidade</field>
    <field name="view_mode">list,form</field>
  </record>

  <menuitem id="menu_sindicato_especialidades"
            name="Especialidades"
            parent="menu_sindicato_config"
            action="action_especialidades"
            sequence="10"/>

  <record id="view_tipo_cota_list" model="ir.ui.view">
    <field name="name">sindicato.tipo.cota.list</field>
    <field name="model">sindicato.tipo.cota</field>
    <field name="arch" type="xml">
      <list string="Tipos de cota">
        <field name="nome"/>
        <field name="cantidade"/>
        <field name="activo"/>
      </list>
    </field>
  </record>

  <record id="view_tipo_cota_form" model="ir.ui.view">
    <field name="name">sindicato.tipo.cota.form</field>
    <field name="model">sindicato.tipo.cota</field>
    <field name="arch" type="xml">
      <form string="Tipo de cota">
        <sheet>
          <group>
            <field name="nome"/>
            <field name="cantidade"/>
            <field name="activo"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_tipos_cota" model="ir.actions.act_window">
    <field name="name">Tipos de cota</field>
    <field name="res_model">sindicato.tipo.cota</field>
    <field name="view_mode">list,form</field>
  </record>

  <menuitem id="menu_sindicato_tipos_cota"
            name="Tipos de cota"
            parent="menu_sindicato_config"
            action="action_tipos_cota"
            sequence="20"/>

</odoo>